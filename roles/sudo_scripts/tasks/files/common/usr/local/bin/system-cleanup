#!/usr/bin/env sh
# =============================================================================
# Arch / Void Linux System Maintenance Script
# Auto-detects the distro (and init system) and runs the matching steps.
# =============================================================================

# --- Configuration ---
CACHE_AGE_DAYS=30
TMP_AGE_DAYS=2
LARGE_FILE_MB=100
PACMAN_KEEP_VERSIONS=2
JOURNAL_VACUUM_TIME="2weeks"
if [ -n "${SUDO_USER:-}" ]; then
  RUN_AS_USER="$SUDO_USER"
else
  RUN_AS_USER=$(id -un) || {
    printf '%s\n' 'system-cleanup: could not determine the current user' >&2
    exit 1
  }
fi
RUN_AS_HOME="${HOME:-}"
if [ "$RUN_AS_USER" != "root" ]; then
  command -v getent >/dev/null 2>&1 || {
    printf '%s\n' 'system-cleanup: getent is required to determine the user home' >&2
    exit 1
  }
  account_entry=$(getent passwd "$RUN_AS_USER") || {
    printf 'system-cleanup: could not find user %s\n' "$RUN_AS_USER" >&2
    exit 1
  }
  RUN_AS_HOME=$(printf '%s\n' "$account_entry" | cut -d: -f6) || {
    printf 'system-cleanup: could not determine the home for %s\n' "$RUN_AS_USER" >&2
    exit 1
  }
fi
if [ -z "$RUN_AS_HOME" ] || [ ! -d "$RUN_AS_HOME" ]; then
  printf 'system-cleanup: invalid home directory for %s\n' "$RUN_AS_USER" >&2
  exit 1
fi
LOG_FILE="/var/log/system-cleanup.log"
SECTION_TIMERS_ENABLED=1

# --- Color codes ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

# --- Summary tracking ---
WARNINGS=0
ERRORS=0
STEPS_OK=0

# --- Distro / init detection (populated by detect_distro / detect_init_system) ---
DISTRO=""
INIT_SYSTEM=""

# =============================================================================
# Logging & Output Helpers
# =============================================================================

_timestamp() {
  date '+%Y-%m-%d %H:%M:%S'
}

_log_raw() {
  timestamp=$(_timestamp) || return 1
  if ! printf "[%s] %s\n" "$timestamp" "$1" >>"$LOG_FILE"; then
    printf 'system-cleanup: could not write %s\n' "$LOG_FILE" >&2
    return 1
  fi
}

init_log() {
  [ -d /var/log ] || {
    printf '%s\n' 'system-cleanup: /var/log does not exist' >&2
    return 1
  }
  [ ! -L "$LOG_FILE" ] || {
    printf 'system-cleanup: refusing symbolic-link log file: %s\n' "$LOG_FILE" >&2
    return 1
  }
  : >"$LOG_FILE" || {
    printf 'system-cleanup: could not create %s\n' "$LOG_FILE" >&2
    return 1
  }
  chmod 0600 "$LOG_FILE" || {
    printf 'system-cleanup: could not secure %s\n' "$LOG_FILE" >&2
    return 1
  }
}

ok() {
  printf "${GREEN}  ✔${NC}  %s\n" "$1"
  _log_raw "[OK]   $1"
  STEPS_OK=$((STEPS_OK + 1))
}

info() {
  printf "${CYAN}  ➜${NC}  %s\n" "$1"
  _log_raw "[INFO] $1"
}

warn() {
  printf "${YELLOW}  ⚠${NC}  %s\n" "$1"
  _log_raw "[WARN] $1"
  WARNINGS=$((WARNINGS + 1))
}

error() {
  printf "${RED}  ✖${NC}  %s\n" "$1"
  _log_raw "[ERR]  $1"
  ERRORS=$((ERRORS + 1))
}

section() {
  printf "\n${BOLD}━━━  %s  ━━━${NC}\n\n" "$1"
  _log_raw "=== $1 ==="
  _SECTION_START=$(date +%s)
}

section_end() {
  if [ "$SECTION_TIMERS_ENABLED" = "1" ] && [ -n "$_SECTION_START" ]; then
    _elapsed=$(($(date +%s) - _SECTION_START))
    printf "${DIM}     (completed in %ds)${NC}\n" "$_elapsed"
    _log_raw "    section elapsed: ${_elapsed}s"
  fi
}

indent() {
  while IFS= read -r line; do
    printf "     ${DIM}%s${NC}\n" "$line"
    if ! printf "     %s\n" "$line" >>"$LOG_FILE"; then
      printf 'system-cleanup: could not write %s\n' "$LOG_FILE" >&2
      return 1
    fi
  done
}

run_and_indent() {
  _command_output=$("$@" 2>&1)
  _command_status=$?
  if [ -n "$_command_output" ]; then
    printf '%s\n' "$_command_output" | indent || return 1
  fi
  return "$_command_status"
}

confirm() {
  printf "${YELLOW}  ?${NC}  %s [y/N]: " "$1"
  read -r response
  case "$response" in
  [yY][eE][sS] | [yY]) return 0 ;;
  *) return 1 ;;
  esac
}

has_cmd() {
  command -v "$1" >/dev/null 2>&1
}

distro_label() {
  case "$DISTRO" in
  arch) printf 'Arch' ;;
  void) printf 'Void' ;;
  *) printf '%s' "$DISTRO" ;;
  esac
}

is_package_installed() {
  pkg="$1"
  case "$DISTRO" in
  arch) pacman -Qq "$pkg" >/dev/null 2>&1 ;;
  void) xbps-query "$pkg" >/dev/null 2>&1 ;;
  esac
}

# =============================================================================
# Pre-flight Checks
# =============================================================================

check_root() {
  uid=$(id -u) || {
    printf '%s\n' 'system-cleanup: could not determine the current user' >&2
    exit 1
  }
  if [ "$uid" -ne 0 ]; then
    printf 'system-cleanup: this script must be run as root. Try: sudo %s\n' "$0" >&2
    exit 1
  fi
}

detect_distro() {
  if [ -r /etc/os-release ]; then
    # shellcheck disable=SC1091
    . /etc/os-release || {
      error "Could not read /etc/os-release."
      exit 1
    }
    DISTRO="${ID:-}"
  fi
  case "$DISTRO" in
  arch | void) ;;
  *)
    error "Unsupported or undetected distro: '$DISTRO'. This script supports Arch and Void."
    exit 1
    ;;
  esac
}

detect_init_system() {
  if has_cmd systemctl && [ -d /run/systemd/system ]; then
    INIT_SYSTEM="systemd"
  else
    INIT_SYSTEM="runit"
  fi
}

check_internet() {
  case "$DISTRO" in
  arch) host="archlinux.org" ;;
  void) host="voidlinux.org" ;;
  esac
  info "Checking internet connectivity ($host)..."
  if ping -c 1 -W 3 "$host" >/dev/null 2>&1; then
    ok "Internet connection is available."
  else
    warn "No internet connection detected. Some steps may fail or be skipped."
  fi
}

# =============================================================================
# Core System Maintenance
# =============================================================================

upgrade_system() {
  section "System Upgrade"
  case "$DISTRO" in
  arch)
    info "Running full system upgrade (pacman -Syu)..."
    if pacman -Syu; then
      ok "System upgrade complete."
    else
      error "System upgrade failed or was aborted."
    fi
    ;;
  void)
    info "Running full system upgrade (xbps-install -Su)..."
    if xbps-install -Su; then
      ok "System upgrade complete."
    else
      error "System upgrade failed or was aborted."
    fi
    ;;
  esac
  section_end
}

check_init_health() {
  section "Init System Health"
  case "$INIT_SYSTEM" in
  systemd) check_systemd_health ;;
  runit) check_runit_health ;;
  esac
  section_end
}

check_systemd_health() {
  info "Checking for failed systemd services..."
  if ! failed=$(systemctl --failed --no-legend); then
    error "Could not query failed systemd services."
  elif [ -n "$failed" ]; then
    warn "Failed systemd services detected:"
    printf "%s\n" "$failed" | indent
  else
    ok "No failed systemd services."
  fi

  info "Checking systemd timers..."
  if ! run_and_indent systemctl list-timers --all --no-pager; then
    error "Could not list systemd timers."
  fi

  info "Checking for services in degraded state..."
  state=$(systemctl is-system-running 2>&1)
  state_status=$?
  case "$state" in
  running) ok "System state: running" ;;
  degraded) warn "System state: degraded — check 'systemctl --failed'" ;;
  *)
    if [ "$state_status" -ne 0 ]; then
      error "Could not determine the systemd state: $state"
    else
      warn "System state: $state"
    fi
    ;;
  esac
}

check_runit_health() {
  info "Checking runit service status (/var/service)..."
  if [ ! -d /var/service ]; then
    warn "/var/service not found — cannot check runit service status."
    return
  fi
  if ! has_cmd sv; then
    warn "'sv' command not found — cannot query runit service status."
    return
  fi

  down_services=""
  for svc_dir in /var/service/*/; do
    [ -d "$svc_dir" ] || continue
    name=${svc_dir%/}
    name=${name##*/}
    status=$(sv status "$name" 2>&1)
    case "$status" in
    run:*) ;;
    *) down_services="$down_services\n  $name: $status" ;;
    esac
  done

  if [ -n "$down_services" ]; then
    warn "Services not running:"
    printf "%b\n" "$down_services" | indent
  else
    ok "All enabled runit services are running."
  fi
}

check_microcode() {
  section "CPU Microcode"
  info "Checking CPU microcode status..."

  if ! cpu_vendor=$(awk '/^vendor_id/ { print $3; exit }' /proc/cpuinfo); then
    error "Could not read CPU information."
    section_end
    return 1
  fi
  ucode_pkg=""
  case "$cpu_vendor" in
  GenuineIntel)
    ucode_pkg="intel-ucode"
    ;;
  AuthenticAMD)
    case "$DISTRO" in
    arch) ucode_pkg="amd-ucode" ;;
    void) ucode_pkg="linux-firmware-amd" ;;
    esac
    ;;
  *)
    info "Unknown CPU vendor: $cpu_vendor. Skipping microcode check."
    ;;
  esac

  if [ -n "$ucode_pkg" ]; then
    if is_package_installed "$ucode_pkg"; then
      ok "$ucode_pkg is installed."
    else
      warn "$ucode_pkg is NOT installed. Install it for CPU security patches."
    fi
  fi

  if ! dmesg_output=$(dmesg); then
    warn "Could not read kernel messages to verify microcode."
  elif printf '%s\n' "$dmesg_output" | grep -qi "microcode updated"; then
    ok "Microcode update applied at boot."
  elif printf '%s\n' "$dmesg_output" | grep -qi "microcode"; then
    info "Microcode present in dmesg (check manually with: dmesg | grep -i microcode)."
  else
    warn "No microcode update detected in dmesg. Ensure your bootloader loads the microcode initrd."
  fi

  section_end
}

check_kernel_updates() {
  section "Kernel Status"
  info "Checking running kernel vs installed kernel..."

  if ! running_kernel=$(uname -r); then
    error "Could not determine the running kernel."
    section_end
    return 1
  fi
  case "$DISTRO" in
  arch)
    if ! installed_kernel=$(pacman -Q linux); then
      error "Could not determine the installed Arch kernel."
      section_end
      return 1
    fi
    installed_kernel=$(printf '%s\n' "$installed_kernel" | awk '{ print $2 }') || {
      error "Could not parse the installed Arch kernel."
      section_end
      return 1
    }
    ;;
  void)
    if ! installed_packages=$(xbps-query -l); then
      error "Could not list installed Void packages."
      section_end
      return 1
    fi
    installed_kernel=$(printf '%s\n' "$installed_packages" |
      awk '$2 ~ /^linux[0-9]/ { print $2; exit }') || {
      error "Could not parse the installed Void kernel."
      section_end
      return 1
    }
    ;;
  esac

  info "Running kernel : $running_kernel"
  info "Installed linux: ${installed_kernel:-unknown}"

  installed_major_minor=$(printf '%s\n' "$installed_kernel" |
    awk 'match($0, /[0-9][0-9]*\.[0-9][0-9]*/) { print substr($0, RSTART, RLENGTH); exit }') || {
    error "Could not parse the installed kernel version."
    section_end
    return 1
  }
  case "$running_kernel" in
  "$installed_major_minor".*) ok "Running kernel appears consistent with installed version." ;;
  *)
    warn "Kernel version mismatch — a reboot may be needed to use the newly installed kernel."
    ;;
  esac

  if has_cmd dkms; then
    info "DKMS module status:"
    if ! run_and_indent dkms status; then
      error "Could not query DKMS module status."
    fi
  fi

  section_end
}

# =============================================================================
# Package Management & Cleanup
# =============================================================================

remove_orphans() {
  section "Orphaned Packages"
  case "$DISTRO" in
  arch) remove_orphans_pacman ;;
  void) remove_orphans_xbps ;;
  esac
  section_end
}

remove_orphans_pacman() {
  info "Scanning for orphaned packages..."
  orphans=$(pacman -Qdtq 2>&1)
  orphan_status=$?
  if [ "$orphan_status" -ne 0 ]; then
    if [ -n "$orphans" ]; then
      error "Could not scan for orphaned pacman packages: $orphans"
      return 1
    fi
    orphans=""
  fi
  if [ -n "$orphans" ]; then
    warn "Found orphaned packages:"
    printf "%s\n" "$orphans" | indent
    if confirm "Remove all orphaned packages?"; then
      # shellcheck disable=SC2086
      if pacman -Rns $orphans; then
        ok "Orphaned packages removed."
      else
        error "Could not remove orphaned packages."
      fi
    else
      info "Skipping orphan removal."
    fi
  else
    ok "No orphaned packages found."
  fi
}

remove_orphans_xbps() {
  info "Scanning for orphaned packages..."
  if ! orphans=$(xbps-query -O); then
    error "Could not scan for orphaned XBPS packages."
    return 1
  fi
  if [ -n "$orphans" ]; then
    warn "Found orphaned packages:"
    printf "%s\n" "$orphans" | indent
    if confirm "Remove all orphaned packages?"; then
      if xbps-remove -o -y; then
        ok "Orphaned packages removed."
      else
        error "Could not remove orphaned packages."
      fi
    else
      info "Skipping orphan removal."
    fi
  else
    ok "No orphaned packages found."
  fi
}

cleanup_old_kernels() {
  section "Old Kernels"
  case "$DISTRO" in
  arch)
    info "Arch Linux removes old kernels automatically during package upgrades."
    ;;
  void)
    if has_cmd vkpurge; then
      info "Checking for old Void Linux kernels..."
      old_kernels=$(vkpurge list 2>&1)
      old_kernel_status=$?
      if [ "$old_kernel_status" -ne 0 ]; then
        if [ -n "$old_kernels" ]; then
          error "Could not list old Void Linux kernels: $old_kernels"
          section_end
          return 1
        fi
        old_kernels=""
      fi
      if [ -n "$old_kernels" ]; then
        warn "Old kernels found taking up space:"
        printf "%s\n" "$old_kernels" | indent
        if confirm "Remove all old kernels (vkpurge rm all)?"; then
          if run_and_indent vkpurge rm all; then
            ok "Old kernels removed."
          else
            error "Could not remove old kernels."
          fi
        else
          info "Skipping old kernel removal."
        fi
      else
        ok "No old kernels found. System is clean."
      fi
    else
      warn "vkpurge command not found. Cannot check for old kernels."
    fi
    ;;
  esac
  section_end
}

clean_package_cache() {
  section "Package Cache"
  case "$DISTRO" in
  arch) clean_pacman_cache ;;
  void) clean_xbps_cache ;;
  esac
  section_end
}

clean_pacman_cache() {
  if has_cmd paccache; then
    info "Removing old cached packages (keeping last $PACMAN_KEEP_VERSIONS versions)..."
    if run_and_indent paccache "-rk$PACMAN_KEEP_VERSIONS"; then
      ok "Old package versions pruned."
    else
      error "Could not prune old package versions."
    fi

    info "Removing all cached versions of uninstalled packages..."
    if run_and_indent paccache -ruk0; then
      ok "Uninstalled package caches cleared."
    else
      error "Could not clear uninstalled package caches."
    fi
  else
    warn "paccache not found — install 'pacman-contrib' for smarter cache management."
    info "Falling back to clearing the entire package cache."
    if confirm "Clear ALL of /var/cache/pacman/pkg/? (no version history kept)"; then
      if pacman -Sc --noconfirm; then
        ok "Pacman cache cleared."
      else
        error "Could not clear the pacman cache."
      fi
    fi
  fi

  cache_size=$(du -sh /var/cache/pacman/pkg/ 2>/dev/null | cut -f1)
  info "Current pacman cache size: ${cache_size:-unknown}"
}

clean_xbps_cache() {
  if has_cmd xbps-remove; then
    info "Removing obsolete package files from the xbps cache..."
    if run_and_indent xbps-remove -O -y; then
      ok "Obsolete cached packages removed."
    else
      error "Could not remove obsolete cached packages."
    fi
  else
    warn "xbps-remove not found."
  fi

  cache_size=$(du -sh /var/cache/xbps/ 2>/dev/null | cut -f1)
  info "Current xbps cache size: ${cache_size:-unknown}"
}

clean_aur_cache() {
  section "AUR Cache"
  aur_helper=""

  has_cmd yay && aur_helper="yay"
  has_cmd paru && aur_helper="paru"

  if [ -n "$aur_helper" ]; then
    info "AUR helper detected: $aur_helper"
    info "Cleaning $aur_helper build files and caches..."
    if [ "$aur_helper" = "yay" ]; then
      if run_and_indent yay -Yc --noconfirm; then
        ok "AUR cache cleaned."
      else
        error "Could not clean the AUR cache."
      fi
    elif [ "$aur_helper" = "paru" ]; then
      if run_and_indent paru -Sc --aur --noconfirm; then
        ok "AUR cache cleaned."
      else
        error "Could not clean the AUR cache."
      fi
    fi
  else
    info "No common AUR helper (yay/paru) detected. Skipping AUR cleanup."
  fi

  section_end
}

update_mirrors() {
  section "Mirror List"
  case "$DISTRO" in
  arch) update_arch_mirrorlist ;;
  void) show_void_mirror_info ;;
  esac
  section_end
}

update_arch_mirrorlist() {
  if has_cmd reflector; then
    info "Updating mirrorlist with reflector (fastest 10 HTTPS mirrors synced within 12h)..."
    if reflector \
      --latest 20 \
      --protocol https \
      --sort rate \
      --age 12 \
      --number 10 \
      --save /etc/pacman.d/mirrorlist; then
      ok "Mirrorlist updated."
    else
      warn "reflector failed to update mirrorlist. Check your connection."
    fi
  else
    info "reflector not installed. Install it to auto-update mirrors: pacman -S reflector"
    info "Current top mirrors in /etc/pacman.d/mirrorlist:"
    grep '^Server' /etc/pacman.d/mirrorlist 2>/dev/null | head -5 | indent
  fi
}

show_void_mirror_info() {
  info "Void mirror selection is interactive (xmirror) and is not run automatically."
  if has_cmd xmirror; then
    info "Run 'sudo xmirror' manually to pick the fastest repository mirror."
  else
    info "Install xmirror to interactively choose a mirror: xbps-install -S xmirror"
  fi
  info "Current configured repository:"
  grep -rh '^repository=' /etc/xbps.d/ /usr/share/xbps.d/ 2>/dev/null | sort -u | indent
}

handle_stale_config_files() {
  section "Stale Config Files"

  case "$DISTRO" in
  arch)
    info "Scanning /etc for .pacnew / .pacsave files..."
    if has_cmd fd; then
      if ! stale_files=$(fd -H '\.pac(new|save)$' /etc); then
        error "Could not scan /etc for .pacnew and .pacsave files."
        section_end
        return 1
      fi
    else
      if ! stale_files=$(find /etc \( -name '*.pacnew' -o -name '*.pacsave' \)); then
        error "Could not scan /etc for .pacnew and .pacsave files."
        section_end
        return 1
      fi
    fi
    ;;
  void)
    info "Scanning /etc for .new files..."
    if has_cmd fd; then
      if ! stale_files=$(fd -H '\.new$' /etc); then
        error "Could not scan /etc for .new files."
        section_end
        return 1
      fi
    else
      if ! stale_files=$(find /etc -name '*.new'); then
        error "Could not scan /etc for .new files."
        section_end
        return 1
      fi
    fi
    ;;
  esac

  if [ -n "$stale_files" ]; then
    warn "Found config files requiring manual review:"
    printf "%s\n" "$stale_files" | indent
    case "$DISTRO" in
    arch) info "Use 'pacdiff' or 'vimdiff' to merge changes." ;;
    void) info "Review each '.new' file and merge manually, then remove it." ;;
    esac
  else
    ok "No stale config files found."
  fi

  section_end
}

# =============================================================================
# Filesystem & User Space Cleanup
# =============================================================================

trim_ssd() {
  section "SSD TRIM"
  info "Checking for SSD/NVMe drives that support TRIM..."

  if [ "$INIT_SYSTEM" = "systemd" ]; then
    if systemctl is-active --quiet fstrim.timer 2>/dev/null; then
      ok "fstrim.timer is active — periodic TRIM is running automatically."
      info "Last TRIM run info:"
      systemctl status fstrim.timer --no-pager 2>/dev/null | grep -E 'Trigger|Last' | indent
    else
      warn "fstrim.timer is not active."
      if confirm "Enable and start fstrim.timer for weekly automatic TRIM?"; then
        if systemctl enable --now fstrim.timer; then
          ok "fstrim.timer enabled."
        else
          error "Could not enable fstrim.timer."
        fi
      fi
    fi
  else
    info "No systemd timer available — periodic TRIM must be scheduled via cron."
    if has_cmd crontab && crontab -l 2>/dev/null | grep -q fstrim; then
      ok "A cron job for fstrim appears to be configured."
    else
      warn "No scheduled TRIM job detected. Consider adding a weekly 'fstrim -av' cron job."
    fi
  fi

  if confirm "Run fstrim now on all mounted filesystems?"; then
    if run_and_indent fstrim -av; then
      ok "TRIM completed."
    else
      error "TRIM failed."
    fi
  fi
  section_end
}

clear_old_cache_files() {
  section "User Cache Cleanup"
  if [ ! -d "$HOME/.cache" ]; then
    info "No user cache directory found."
    section_end
    return 0
  fi

  cache_size_before=$(du -sh "$HOME/.cache" 2>/dev/null | cut -f1)
  info "User cache size before: ${cache_size_before:-unknown}"

  info "Removing files older than ${CACHE_AGE_DAYS} days (max depth 4) from ~/.cache..."
  if has_cmd fd; then
    if ! fd --type file --max-depth 4 --changed-before "${CACHE_AGE_DAYS}d" . "$HOME/.cache" -X rm; then
      error "Could not remove old user cache files."
      section_end
      return 1
    fi
  else
    if ! find "$HOME/.cache" -maxdepth 4 -type f -mtime +"$CACHE_AGE_DAYS" -delete; then
      error "Could not remove old user cache files."
      section_end
      return 1
    fi
  fi

  cache_size_after=$(du -sh "$HOME/.cache" 2>/dev/null | cut -f1)
  ok "Old cache files removed. Size after: ${cache_size_after:-unknown}"

  section_end
}

clear_old_tmp_files() {
  section "Temp File Cleanup"
  if [ -d /tmp ]; then
    info "Removing own files older than ${TMP_AGE_DAYS} days from /tmp..."
    if find /tmp -type f -user "$RUN_AS_USER" -mtime +"$TMP_AGE_DAYS" -delete; then
      ok "/tmp old files cleared."
    else
      error "Could not remove old temporary files."
    fi
  fi

  if [ -d "$HOME/.config/pulse" ]; then
    info "Removing stale PulseAudio/PipeWire temp files..."
    if ! find "$HOME/.config/pulse" -name '*.tdb' -mtime +7 -delete; then
      error "Could not remove stale PulseAudio/PipeWire files."
    fi
  fi

  section_end
}

clear_all_cache() {
  if confirm "Clear ALL user cache (~/.cache)? Safe, but first app launches may be slower."; then
    if [ ! -d "$HOME/.cache" ]; then
      info "No user cache directory found."
    elif rm -rf "$HOME/.cache/"* "$HOME/.cache/".[!.]* "$HOME/.cache/"..?*; then
      ok "Entire user cache cleared."
    else
      error "Could not clear the entire user cache."
    fi
  else
    info "Skipping full user cache clear."
  fi
}

cleanup_coredumps() {
  section "Coredumps"
  info "Checking for coredump files..."

  if has_cmd coredumpctl; then
    if ! coredump_list=$(coredumpctl list --no-pager); then
      error "Could not list coredumps."
      section_end
      return 1
    fi
    coredump_count=$(printf '%s\n' "$coredump_list" |
      awk '$1 != "TIME" && $0 != "No coredumps found." && NF { count++ } END { print count + 0 }') || {
      error "Could not count coredumps."
      section_end
      return 1
    }
    if [ "$coredump_count" -gt 0 ] 2>/dev/null; then
      warn "$coredump_count coredump(s) found:"
      printf '%s\n' "$coredump_list" | tail -10 | indent
      if confirm "Clear all coredumps? (you'll lose crash debug info)"; then
        if [ -d /var/lib/systemd/coredump/ ]; then
          if find /var/lib/systemd/coredump/ -type f -delete; then
            ok "Stored coredump files cleared; journal entries were retained."
          else
            error "Could not remove stored coredump files."
          fi
        else
          info "No stored coredump files found; journal entries were retained."
        fi
      fi
    else
      ok "No coredumps found."
    fi
  else
    core_files=$(find "$HOME" /tmp -maxdepth 3 -name 'core' -o -name 'core.*' 2>/dev/null | head -5)
    if [ -n "$core_files" ]; then
      warn "Raw core files found:"
      printf "%s\n" "$core_files" | indent
    else
      ok "No coredump files found."
    fi
  fi

  section_end
}

check_broken_symlinks() {
  section "Broken Symlinks"
  info "Scanning $HOME for broken symlinks..."

  broken=""
  if has_cmd fd; then
    broken=$(fd --type l --base-directory "$HOME" . 2>/dev/null | while IFS= read -r link; do
      full="$HOME/$link"
      readlink -e "$full" >/dev/null 2>&1 || printf "%s\n" "$full"
    done)
  else
    broken=$(find "$HOME" -xtype l 2>/dev/null)
  fi

  if [ -n "$broken" ]; then
    warn "Broken symlinks found:"
    printf "%s\n" "$broken" | indent
  else
    ok "No broken symlinks found in \$HOME."
  fi
  section_end
}

find_large_files() {
  section "Large Files"
  info "Finding top 20 largest files (>${LARGE_FILE_MB}MB) in \$HOME..."

  if has_cmd fd; then
    results=$(fd --type file --size "+${LARGE_FILE_MB}M" --base-directory "$HOME" . -X ls -lh 2>/dev/null | sort -k5,5hr | head -n 20)
  else
    results=$(find "$HOME" -type f -size "+${LARGE_FILE_MB}M" -exec ls -lh {} \; 2>/dev/null | sort -k5,5hr | head -n 20)
  fi

  if [ -n "$results" ]; then
    info "Large files found:"
    printf "%s\n" "$results" | indent
  else
    ok "No files larger than ${LARGE_FILE_MB}MB found in \$HOME."
  fi
  section_end
}

check_stale_desktop_entries() {
  section "Stale Desktop Entries"
  info "Checking ~/.local/share/applications for broken .desktop entries..."

  stale=""
  for f in "$HOME/.local/share/applications/"*.desktop; do
    [ -f "$f" ] || continue
    exec_line=$(grep -m1 '^Exec=' "$f" 2>/dev/null | sed 's/^Exec=//' | awk '{print $1}')
    exec_cmd=$(printf "%s" "$exec_line" | sed 's/ %.*//')
    if [ -n "$exec_cmd" ] && ! has_cmd "$exec_cmd" && [ ! -f "$exec_cmd" ]; then
      stale="$stale\n  $f  (Exec: $exec_cmd)"
    fi
  done

  if [ -n "$stale" ]; then
    warn "Potentially stale .desktop entries (executable not found):"
    printf "%b\n" "$stale" | indent
  else
    ok "No stale .desktop entries found."
  fi
  section_end
}

# =============================================================================
# System-Specific Cleanups
# =============================================================================

cleanup_docker() {
  section "Docker Cleanup"
  if has_cmd docker; then
    if confirm "Prune unused Docker images, containers, volumes, and networks?"; then
      if run_and_indent docker system prune -a -f --volumes; then
        ok "Docker cleanup complete."
      else
        error "Docker cleanup failed."
      fi
    else
      info "Skipping Docker cleanup."
    fi
  else
    info "Docker not installed. Skipping."
  fi
  section_end
}

cleanup_flatpak() {
  section "Flatpak Cleanup"
  if has_cmd flatpak; then
    info "Removing unused Flatpak runtimes and applications..."
    if run_and_indent flatpak uninstall --unused -y; then
      ok "Flatpak cleanup complete."
    else
      error "Flatpak cleanup failed."
    fi

    info "Checking for Flatpak updates..."
    if run_and_indent flatpak update -y; then
      ok "Flatpak packages updated."
    else
      error "Flatpak update failed."
    fi
  else
    info "Flatpak not installed. Skipping."
  fi
  section_end
}

cleanup_snap() {
  section "Snap Cleanup"
  if has_cmd snap; then
    info "Removing disabled/old Snap revisions..."
    if ! snap_list=$(snap list --all); then
      error "Could not list installed Snap revisions."
    else
      disabled_revisions=$(printf '%s\n' "$snap_list" |
        awk '/disabled/ { print $1, $3 }') || {
        error "Could not identify disabled Snap revisions."
        section_end
        return 1
      }
      if [ -z "$disabled_revisions" ]; then
        info "No disabled Snap revisions found."
      else
        snap_cleanup_failed=0
        while IFS=' ' read -r snapname revision; do
          [ -n "$snapname" ] || continue
          if ! run_and_indent snap remove "$snapname" "--revision=$revision"; then
            error "Could not remove Snap revision $snapname ($revision)."
            snap_cleanup_failed=1
          fi
        done <<EOF
$disabled_revisions
EOF
        if [ "$snap_cleanup_failed" -eq 0 ]; then
          ok "Old Snap revisions removed."
        fi
      fi
    fi
  else
    info "Snap not installed. Skipping."
  fi
  section_end
}

cleanup_dev_caches() {
  section "Developer Tool Caches"

  if [ -d "$HOME/.cargo/registry" ]; then
    cargo_size=$(du -sh "$HOME/.cargo/registry" 2>/dev/null | cut -f1)
    info "Cargo registry cache size: ${cargo_size:-unknown}"
    if has_cmd cargo; then
      if confirm "Run 'cargo cache --autoclean' to clean Cargo cache? (install cargo-cache if needed)"; then
        if has_cmd cargo-cache; then
          if ! run_and_indent cargo cache --autoclean; then
            error "Could not clean the Cargo cache."
          fi
        else
          info "cargo-cache not found. Install with: cargo install cargo-cache"
        fi
      fi
    fi
  fi

  if [ -d "$HOME/go/pkg/mod/cache" ]; then
    go_size=$(du -sh "$HOME/go/pkg/mod/cache" 2>/dev/null | cut -f1)
    info "Go module cache size: ${go_size:-unknown}"
    if has_cmd go; then
      if confirm "Clean Go module download cache (go clean -modcache)?"; then
        if run_and_indent go clean -modcache; then
          ok "Go module cache cleared."
        else
          error "Could not clear the Go module cache."
        fi
      fi
    fi
  fi

  if has_cmd npm; then
    if ! npm_cache=$(npm config get cache); then
      error "Could not determine the npm cache directory."
    else
      npm_size=$(du -sh "$npm_cache" 2>/dev/null | cut -f1)
      info "npm cache size: ${npm_size:-unknown} at ${npm_cache:-~/.npm}"
      if confirm "Clean npm cache?"; then
        if run_and_indent npm cache clean --force; then
          ok "npm cache cleared."
        else
          error "Could not clean the npm cache."
        fi
      fi
    fi
  fi

  if has_cmd pip; then
    if confirm "Clean pip cache?"; then
      if run_and_indent pip cache purge; then
        ok "pip cache cleared."
      else
        error "Could not clean the pip cache."
      fi
    fi
  fi

  section_end
}

# =============================================================================
# System Information & Final Steps
# =============================================================================

check_disk_usage() {
  section "Disk Usage"
  info "Filesystem usage:"
  df -h --output=source,size,used,avail,pcent,target 2>/dev/null | grep -v 'tmpfs\|devtmpfs\|udev' | indent

  df -h 2>/dev/null | awk 'NR>1 && $5+0 > 85 {print $6, $5}' | while read -r mp pct; do
    warn "Disk usage high on $mp: $pct"
  done

  info "Top 10 largest directories in \$HOME:"
  du -sh "$HOME"/.[!.]* "$HOME"/* 2>/dev/null | sort -hr | head -10 | indent

  section_end
}

cleanup_logs() {
  section "System Logs"
  if [ "$INIT_SYSTEM" = "systemd" ]; then
    cleanup_journald
  else
    cleanup_runit_logs
  fi
  section_end
}

cleanup_journald() {
  if ! journal_size=$(journalctl --disk-usage); then
    error "Could not determine journal disk usage."
    return 1
  fi
  info "Current journal disk usage: $journal_size"

  info "Vacuuming journal (keeping last $JOURNAL_VACUUM_TIME)..."
  if run_and_indent journalctl "--vacuum-time=$JOURNAL_VACUUM_TIME"; then
    ok "Journal vacuum complete."
  else
    error "Journal vacuum failed."
  fi
}

cleanup_runit_logs() {
  log_dir="/var/log"
  info "Checking log sizes under $log_dir..."
  du -sh "$log_dir"/*/ 2>/dev/null | sort -hr | head -10 | indent
  info "Runit/svlogd logs rotate automatically per-service; review large logs above manually if disk space is low."
}

cleanup_nix() {
  section "Nix Cleanup"
  if ! has_cmd nix; then
    info "Nix not installed. Skipping."
    section_end
    return
  fi

  if [ ! -d /nix/store ]; then
    warn "'nix' command found but /nix/store missing. Skipping."
    section_end
    return
  fi

  store_size_before=$(du -sh /nix/store 2>/dev/null | cut -f1)
  info "Nix store size before cleanup: ${store_size_before:-unknown}"

  info "Wiping old nix-profile generation history (older than 14 days)..."
  if nix profile wipe-history --older-than 14d >/dev/null 2>&1; then
    ok "Old profile generations wiped."
  else
    warn "Could not wipe profile history (no profile, or unsupported nix version)."
  fi

  info "Collecting garbage (removing unreferenced store paths)..."
  if run_and_indent nix-collect-garbage -d; then
    ok "Garbage collection complete."
  else
    error "nix-collect-garbage failed."
  fi

  info "Optimising store (deduplicating via hardlinks)..."
  if run_and_indent nix-store --optimise; then
    ok "Store optimised."
  else
    error "nix-store --optimise failed."
  fi

  store_size_after=$(du -sh /nix/store 2>/dev/null | cut -f1)
  info "Nix store size after cleanup: ${store_size_after:-unknown}"

  section_end
}

rebuild_initramfs() {
  section "Initramfs Rebuild"
  case "$DISTRO" in
  arch) rebuild_initramfs_arch ;;
  void) rebuild_initramfs_void ;;
  esac
  section_end
}

rebuild_initramfs_arch() {
  if confirm "Rebuild initramfs (mkinitcpio -P)? Recommended after kernel/hook changes."; then
    info "Rebuilding initramfs for all presets..."
    if run_and_indent mkinitcpio -P; then
      ok "initramfs rebuilt."
    else
      error "Could not rebuild the initramfs."
      return 1
    fi

    if [ "$INIT_SYSTEM" = "systemd" ]; then
      info "Restarting systemd-vconsole-setup..."
      if systemctl restart systemd-vconsole-setup.service; then
        ok "Console setup reloaded."
      else
        error "Could not reload console setup."
      fi
    fi
  else
    info "Skipping initramfs rebuild."
  fi
}

rebuild_initramfs_void() {
  if ! has_cmd dracut; then
    info "dracut not installed — Void doesn't require an initramfs unless using LVM/encryption/etc."
    return
  fi
  if confirm "Regenerate all dracut initramfs images? Recommended after kernel/hook changes."; then
    info "Regenerating initramfs for all installed kernels..."
    if run_and_indent dracut --regenerate-all --force; then
      ok "initramfs regenerated."
    else
      error "Could not regenerate the initramfs."
    fi
  else
    info "Skipping initramfs rebuild."
  fi
}

check_failed_crons() {
  section "Cron / Timer Health"
  if has_cmd crontab; then
    info "User crontab:"
    if crontab_contents=$(crontab -u "$RUN_AS_USER" -l 2>&1); then
      if [ -n "$crontab_contents" ]; then
        printf '%s\n' "$crontab_contents" | indent
      else
        info "No user crontab set."
      fi
    elif [ -z "$crontab_contents" ] ||
      printf '%s\n' "$crontab_contents" | grep -q 'no crontab for'; then
      info "No user crontab set."
    else
      error "Could not read the crontab for $RUN_AS_USER: $crontab_contents"
    fi
  fi

  info "Anacron spool (recent jobs):"
  if [ ! -d /var/spool/anacron/ ]; then
    info "No anacron spool found."
  elif ! anacron_jobs=$(find /var/spool/anacron/ -maxdepth 1 -mindepth 1 -exec ls -ld {} +); then
    error "Could not inspect the anacron spool."
  elif [ -n "$anacron_jobs" ]; then
    printf '%s\n' "$anacron_jobs" | indent
  else
    info "No anacron jobs found."
  fi

  section_end
}

check_distro_news() {
  section "Distribution News"
  case "$DISTRO" in
  arch) check_arch_news ;;
  void) check_void_news ;;
  esac
  section_end
}

check_arch_news() {
  if has_cmd curl; then
    info "Fetching latest Arch Linux news headlines..."
    news=$(curl -s --max-time 10 "https://archlinux.org/feeds/news/" 2>/dev/null |
      grep -oP '(?<=<title>)[^<]+' | grep -v '^Arch Linux' | head -5)
    if [ -n "$news" ]; then
      info "Latest news:"
      printf "%s\n" "$news" | indent
    else
      info "Could not fetch news. Visit: https://archlinux.org/news/"
    fi
  else
    info "curl not available. Check https://archlinux.org/news/ manually."
  fi
}

check_void_news() {
  info "Void Linux does not publish a formal news feed like Arch."
  info "Check the void-packages changelog for manual intervention notes:"
  info "  https://github.com/void-linux/void-packages/commits/master"
  info "Or check announcements at: https://voidlinux.org"
}

# =============================================================================
# Final Summary
# =============================================================================

print_summary() {
  printf '%b\n' "\n${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
  printf '%b\n' "${BOLD}  Maintenance Complete — Summary${NC}"
  printf '%b\n\n' "${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
  printf "  ${GREEN}✔ Passed  :${NC} %s\n" "$STEPS_OK"
  printf "  ${YELLOW}⚠ Warnings:${NC} %s\n" "$WARNINGS"
  printf "  ${RED}✖ Errors  :${NC} %s\n\n" "$ERRORS"
  printf "  ${DIM}Full log saved to: %s${NC}\n\n" "$LOG_FILE"

  if [ "$ERRORS" -gt 0 ]; then
    printf '%b\n' "  ${RED}Action required — check errors above.${NC}"
  elif [ "$WARNINGS" -gt 0 ]; then
    printf '%b\n' "  ${YELLOW}Review warnings above for optional improvements.${NC}"
  else
    printf '%b\n' "  ${GREEN}All checks passed. System is in good shape!${NC}"
  fi

  printf '%b\n' "\n  ${CYAN}Remember to check for distro-specific manual interventions:${NC}"
  case "$DISTRO" in
  arch) printf '%b\n\n' "  ${CYAN}https://archlinux.org/news/${NC}" ;;
  void) printf '%b\n\n' "  ${CYAN}https://voidlinux.org${NC}" ;;
  esac

  _log_raw "=== SUMMARY: OK=$STEPS_OK WARN=$WARNINGS ERR=$ERRORS ==="
}

# =============================================================================
# Main
# =============================================================================

main() {
  check_root
  init_log || return 1
  detect_distro
  detect_init_system
  HOME="$RUN_AS_HOME"
  export HOME

  if ! printf "# %s Linux Maintenance Log\n# Started: %s\n# User: %s\n\n" \
    "$(distro_label)" "$(_timestamp)" "$RUN_AS_USER" >"$LOG_FILE"; then
    printf 'system-cleanup: could not initialize %s\n' "$LOG_FILE" >&2
    return 1
  fi

  printf '%b\n' "\n${BOLD}╔══════════════════════════════════════════════════╗${NC}"
  case "$DISTRO" in
  arch) printf '%b\n' "${BOLD}║     Arch Linux System Maintenance Script          ║${NC}" ;;
  void) printf '%b\n' "${BOLD}║     Void Linux System Maintenance Script         ║${NC}" ;;
  esac
  printf '%b\n\n' "${BOLD}╚══════════════════════════════════════════════════╝${NC}"
  printf "  Distro:  %s\n" "$(distro_label)"
  printf "  Init:    %s\n" "$INIT_SYSTEM"
  printf "  Started: %s\n" "$(_timestamp)"
  printf "  Log:     %s\n" "$LOG_FILE"

  check_internet

  upgrade_system
  check_init_health
  check_microcode
  check_kernel_updates

  update_mirrors
  remove_orphans
  cleanup_old_kernels
  clean_package_cache
  if [ "$DISTRO" = "arch" ]; then
    clean_aur_cache
  fi
  handle_stale_config_files

  trim_ssd
  clear_old_cache_files
  clear_old_tmp_files
  clear_all_cache
  cleanup_coredumps
  check_broken_symlinks
  find_large_files
  check_stale_desktop_entries

  cleanup_docker
  cleanup_flatpak
  cleanup_snap
  cleanup_nix
  cleanup_dev_caches

  check_disk_usage
  cleanup_logs
  check_failed_crons
  rebuild_initramfs
  check_distro_news

  print_summary
  [ "$ERRORS" -eq 0 ]
}

main
