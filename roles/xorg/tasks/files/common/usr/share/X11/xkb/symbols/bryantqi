default partial alphanumeric_keys modifier_keys
xkb_symbols "bryantqi" {
    name[Group1]= "English (Bryant Qwerty, International, Standard Modifiers)";
    key <TLDE> { [ dead_grave,   dead_tilde, grave,        asciitilde     ] };
    key <AE01> { [ bracketleft,  1          ] };
    key <AE02> { [ braceleft,    2          ] };
    key <AE03> { [ parenleft,    3          ] };
    key <AE04> { [ percent,      4          ] };
    key <AE05> { [ equal,        5          ] };
    key <AE06> { [ ampersand,    6,          dead_circumflex, dead_circumflex  ] };
    key <AE07> { [ parenright,   7          ] };
    key <AE08> { [ braceright,   8          ] };
    key <AE09> { [ bracketright, 9,          dead_grave,   dead_breve     ] };
    key <AE10> { [ exclam,       0,          exclamdown      ] };
    key <AE11> { [ asterisk,     dollar     ] };
    key <AE12> { [ numbersign,   at,         dead_tilde      ] };
    key <AD01> { [ q,            Q          ] };
    key <AD02> { [ w,            W          ] };
    key <AD03> { [ e,            E          ] };
    key <AD04> { [ r,            R          ] };
    key <AD05> { [ t,            T          ] };
    key <AD06> { [ y,            Y          ] };
    key <AD07> { [ u,            U          ] };
    key <AD08> { [ i,            I          ] };
    key <AD09> { [ o,            O          ] };
    key <AD10> { [ p,            P          ] };
    key <AD11> { [ slash,        question,   questiondown    ] };
    key <AD12> { [ asciicircum,  plus       ] };
    key <AC01> { [ a,            A          ] };
    key <AC02> { [ s,            S          ] };
    key <AC03> { [ d,            D          ] };
    key <AC04> { [ f,            F          ] };
    key <AC05> { [ g,            G          ] };
    key <AC06> { [ h,            H          ] };
    key <AC07> { [ j,            J          ] };
    key <AC08> { [ k,            K          ] };
    key <AC09> { [ l,            L          ] };
    key <AC10> { [ semicolon,    colon      ] };
    key <AC11> { [ dead_acute,   dead_diaeresis, apostrophe, quotedbl    ] };
    key <BKSL> { [ backslash,    bar        ] };
    key <AB01> { [ z,            Z          ] };
    key <AB02> { [ x,            X          ] };
    key <AB03> { [ c,            C          ] };
    key <AB04> { [ v,            V          ] };
    key <AB05> { [ b,            B          ] };
    key <AB06> { [ n,            N,          ntilde,       Ntilde         ] };
    key <AB07> { [ m,            M          ] };
    key <AB08> { [ comma,        less       ] };
    key <AB09> { [ period,       greater    ] };
    key <AB10> { [ minus,        underscore,   questiondown ] };
};
