#!/usr/bin/env sh

cd "$(dirname "$0")" || {
  printf "ERROR: cannot cd to script directory\n" >&2
  exit 1
}

PLAYBOOK="./local.yml"
SECRETS_DIR=".secrets"
BECOME_FILE="$SECRETS_DIR/.become_password"
VAULT_FILE="$SECRETS_DIR/.passphrase"
TTY_ECHO_DISABLED=0

info() {
  printf "  → %s\n" "$1"
}

die() {
  printf "\nERROR: %s\n" "$1" >&2
  exit 1
}

restore_tty() {
  [ "$TTY_ECHO_DISABLED" = "1" ] || return 0
  [ -r /dev/tty ] || return 1
  stty echo </dev/tty
  TTY_ECHO_DISABLED=0
}

cleanup_terminal() {
  if ! restore_tty; then
    printf "ERROR: failed to restore terminal echo\n" >&2
  fi
}

read_secret() {
  prompt="$1"

  [ -r /dev/tty ] || return 1
  printf "%s" "$prompt" >/dev/tty || return 1
  stty -echo </dev/tty || return 1
  IFS= read -r secret </dev/tty
  status=$?
  if ! restore_tty; then
    printf "\nERROR: failed to restore terminal echo\n" >&2
    return 1
  fi
  printf "\n" >/dev/tty || return 1

  [ "$status" -eq 0 ] || return 1
  [ -n "$secret" ] || return 1
  printf "%s" "$secret"
}

[ -n "${HOME:-}" ] || die "HOME is required"
uid=$(id -u) || die "Could not determine the current user"
[ "$uid" -ne 0 ] || die "Run setup as a regular user, not root"
trap cleanup_terminal 0
trap 'cleanup_terminal; exit 1' 1 2 15
umask 077
STATE_DIR="$HOME/.local/state/ansible_setup"
FIRST_RUN="$STATE_DIR/first_run_completed"

mkdir -p "$SECRETS_DIR" || die "Failed to create $SECRETS_DIR"
chmod 700 "$SECRETS_DIR" || die "Failed to set permissions on $SECRETS_DIR"

if [ ! -f "$BECOME_FILE" ]; then
  TTY_ECHO_DISABLED=1
  p=$(read_secret "Enter sudo/become password: ") || die "Failed to read become password"
  TTY_ECHO_DISABLED=0
  printf "%s" "$p" >"$BECOME_FILE" || die "Failed to write become password"
  unset p
fi
chmod 600 "$BECOME_FILE" || die "Failed to secure become password file"

if [ ! -f "$VAULT_FILE" ]; then
  TTY_ECHO_DISABLED=1
  v=$(read_secret "Enter ansible-vault passphrase: ") || die "Failed to read vault passphrase"
  TTY_ECHO_DISABLED=0
  printf "%s" "$v" >"$VAULT_FILE" || die "Failed to write vault passphrase"
  unset v
fi
chmod 600 "$VAULT_FILE" || die "Failed to secure vault passphrase file"

[ -f "$BECOME_FILE" ] || die "$BECOME_FILE missing"
[ -f "$VAULT_FILE" ] || die "$VAULT_FILE missing"

if [ -f /etc/os-release ]; then
  # shellcheck disable=SC1091
  . /etc/os-release || die "Failed to read /etc/os-release"
  os="${ID:-}"
else
  uname_s=$(uname -s) || die "Could not detect OS"
  os=$(printf '%s\n' "$uname_s" | tr '[:upper:]' '[:lower:]') || die "Could not normalize OS name"
fi

[ -n "$os" ] || die "Could not detect OS"
command -v sudo >/dev/null 2>&1 || die "sudo is required to install and enable Nix"

case "$os" in
arch)
  info "Installing Nix with pacman..."
  sudo pacman -S --needed --noconfirm nix || die "Pacman failed to install Nix"
  info "Enabling the Nix daemon service..."
  sudo systemctl enable --now nix-daemon.service || die "Failed to enable Nix daemon"
  ;;
void)
  info "Installing Nix with xbps..."
  sudo xbps-install -S -y nix || die "XBPS failed to install Nix"
  nix_service_dir="/etc/sv/nix-daemon"
  nix_service_link="/var/service/nix-daemon"
  nix_service_name="nix-daemon"
  ;;
*)
  die "Unsupported OS '$os'"
  ;;
esac

command -v nix >/dev/null 2>&1 || die "Nix is unavailable after installation"

case "$os" in
arch)
  sudo systemctl is-active --quiet nix-daemon.service || die "Nix daemon is not active"
  ;;
void)
  [ -d "$nix_service_dir" ] || die "Nix service directory '$nix_service_dir' is missing"

  if [ ! -L "$nix_service_link" ]; then
    [ ! -e "$nix_service_link" ] || die "Nix service path '$nix_service_link' is not a symlink"
    info "Enabling the Nix daemon service..."
    sudo ln -s "$nix_service_dir" "$nix_service_link" || die "Failed to enable the Nix daemon"
  fi

  sudo sv up "$nix_service_name" || die "Failed to start the Nix daemon"
  ;;
esac
export NIX_REMOTE=daemon

info "Installing common Galaxy collections..."
nix --extra-experimental-features 'nix-command flakes' develop -c \
  ansible-galaxy collection install -r requirements/common.yml >/dev/null || die "Failed to install common collections"

if [ -f "requirements/${os}.yml" ]; then
  info "Installing Galaxy collections for $os..."
  nix --extra-experimental-features 'nix-command flakes' develop -c \
    ansible-galaxy collection install -r "requirements/${os}.yml" >/dev/null || die "Failed to install OS-specific collections"
fi

while true; do
  printf "Choose display_server (xorg) [default: xorg]: " >/dev/tty || die "Failed to write display server prompt"
  read -r ds </dev/tty || die "Failed to read display server"
  ds="${ds:-xorg}"
  case "$ds" in
  xorg) break ;;
  *) printf "  Invalid — enter 'xorg', or press Enter for default\n" >/dev/tty || die "Failed to write display server prompt" ;;
  esac
done

info "Running playbook for OS: $os with display_server: $ds"

nix --extra-experimental-features 'nix-command flakes' develop -c \
  ansible-playbook "$PLAYBOOK" \
  --become-password-file="$BECOME_FILE" \
  --vault-password-file="$VAULT_FILE" \
  --extra-vars "display_server=$ds" || die "Ansible playbook execution failed!"

mkdir -p "$STATE_DIR" || die "Failed to create state directory"

if [ ! -f "$FIRST_RUN" ]; then
  info "First run done — reboot, then run this script again to finish."
  touch "$FIRST_RUN" || die "Failed to create first run lock file"
  exit 0
fi

printf "\n═══════════════════════════════════════════════\n"
printf "  Manual tasks remaining (cannot be automated)\n"
printf "═══════════════════════════════════════════════\n"
printf "  • Set GTK theme using lxappearance GUI\n"
printf "  • Log in to: Browser, Outlook, Bitwarden, GitHub, Google, Twitch\n"
printf "  • Retrieve backups: Music, Brave, Books\n"
printf "  • Bitwarden: login and paste new token session in gopass\n"
printf "  • YAY: Install downgrade, ventoy-bin, dragon-drop, brave-origin, grpcurl-bin, helium-browser-bin\n"
printf "═══════════════════════════════════════════════\n"

printf "\n══════════════════════════════════════════════════════════════════════════════\n"
printf "  Steam Installation & Setup\n"
printf "══════════════════════════════════════════════════════════════════════════════\n"
printf "  [Arch Linux]\n"
printf "  • pacman -S steam\n\n"
printf "  [Void Linux - i686]\n"
printf "  • xbps-install -S steam (No extra packages needed)\n\n"
printf "  [Void Linux - x86_64]\n"
printf "  • 1. Enable Repos:  xbps-install -S void-repo-multilib{,-nonfree} && xbps-install -S\n"
printf "  • 2. Base 32-bit:   xbps-install -S libgcc-32bit libstdc++-32bit libdrm-32bit libglvnd-32bit libva-32bit\n"
printf "  • 3. Video Drivers (Choose ONE):\n"
printf "       - Open Source: xbps-install -S mesa-dri-32bit\n"
printf "       - NVIDIA:      xbps-install -S nvidia-libs-32bit (or nvidia470/390-libs-32bit for older GPUs)\n\n"
printf "  [Void Linux - Fixes & Extras]\n"
printf "  • Mono / DBUS: Enable dbus service. Install 'mono' if specific games fail.\n"
printf "  • Performance: Add user to 'video' group for smooth streaming.\n"
printf "  • No Audio:    Install pulseaudio, alsa-plugins-pulseaudio + their 32-bit equivalents.\n"
printf "  • Proton Hangs:Raise 'nofile' limit in limits.conf (fixes eventfd: too many open files).\n"
printf "  • Lib Errors:  Run: LD_PRELOAD='/usr/\$LIB/libstdc++.so.6 /usr/\$LIB/libgcc_s.so.1 /usr/\$LIB/libxcb.so.1' steam\n"
printf "══════════════════════════════════════════════════════════════════════════════\n"
