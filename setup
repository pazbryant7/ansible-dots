#!/usr/bin/env sh
set -eu

cd "$(dirname "$0")" || {
	printf "ERROR: cannot cd to script directory\n" >&2
	exit 1
}

PLAYBOOK="./local.yml"
BECOME_FILE=".secrets/.become_password"
VAULT_FILE=".secrets/.passphrase"
STATE_DIR="$HOME/.local/state/ansible_setup"
FIRST_RUN="$STATE_DIR/first_run_completed"

# ── Helpers ───────────────────────────────────────────────────────────────────

info() { printf "  → %s\n" "$1"; }
die() {
	printf "\nERROR: %s\n" "$1" >&2
	exit 1
}

# ── Secrets ───────────────────────────────────────────────────────────────────

secrets() {
	mkdir -p .secrets && chmod 700 .secrets
	if [ ! -f "$BECOME_FILE" ]; then
		printf "Enter sudo/become password: " >/dev/tty
		read -r p </dev/tty && printf "%s" "$p" >"$BECOME_FILE" && chmod 600 "$BECOME_FILE"
	fi
	if [ ! -f "$VAULT_FILE" ]; then
		printf "Enter ansible-vault passphrase: " >/dev/tty
		read -r v </dev/tty && printf "%s" "$v" >"$VAULT_FILE" && chmod 600 "$VAULT_FILE"
	fi
	[ -f "$BECOME_FILE" ] || die "$BECOME_FILE missing"
	[ -f "$VAULT_FILE" ] || die "$VAULT_FILE missing"
}

# ── OS & dependencies ─────────────────────────────────────────────────────────

detect_os() {
	[ -f /etc/os-release ] && {
		. /etc/os-release
		printf "%s" "$ID"
		return
	}
	uname -s | tr '[:upper:]' '[:lower:]'
}

install_ansible() {
	command -v ansible >/dev/null 2>&1 && return 0
	info "Installing Ansible for $1..."
	case "$1" in
	arch) sudo pacman -S --noconfirm ansible ansible-core ansible-lint ;;
	*) die "Unsupported OS '$1' — install Ansible manually" ;;
	esac
}

setup_deps() {
	os="$(detect_os)"
	[ -n "$os" ] || die "Could not detect OS"
	install_ansible "$os"
	req="requirements/${os}.yml"
	common="requirements/common.yml"
	if [ -f "$req" ]; then
		info "Installing Galaxy collections for $os..."
		ansible-galaxy collection install -r "$req" &&
			ansible-galaxy collection install -r "$common"
	fi
}

# ── Prompts ───────────────────────────────────────────────────────────────────

prompt() {
	# prompt <label> <opt1> <opt2>  →  prints chosen value
	while true; do
		printf "Choose %s (%s/%s): " "$1" "$2" "$3" >/dev/tty
		read -r ans </dev/tty
		case "$ans" in
		"$2" | "$3")
			printf "%s" "$ans"
			return
			;;
		*) printf "  Invalid — enter '%s' or '%s'\n" "$2" "$3" >/dev/tty ;;
		esac
	done
}

# ── Playbook ──────────────────────────────────────────────────────────────────

run() {
	shell="zsh"
	compositor="$(prompt "compositor" "xorg" "wayland")"
	info "Running playbook..."
	ansible-playbook "$PLAYBOOK" \
		--become-password-file="$BECOME_FILE" \
		--vault-password-file="$VAULT_FILE" \
		--extra-vars "chosen_shell=${shell} chosen_compositor=${compositor}"
}

# ── Post-install ──────────────────────────────────────────────────────────────

post() {
	mkdir -p "$STATE_DIR"
	if [ ! -f "$FIRST_RUN" ]; then
		info "First run done — reboot, then run this script again to finish."
		touch "$FIRST_RUN"
		exit 0
	fi
	printf "\n"
	printf "═══════════════════════════════════════════════\n"
	printf "  Manual tasks remaining (cannot be automated)\n"
	printf "═══════════════════════════════════════════════\n"
	printf "  • Set GTK theme using nwg-look GUI\n"
	printf "  • Log in to: Browser, Outlook, Bitwarden,\n"
	printf "               GitHub, Google, Twitch\n"
	printf "  • Retrive backups: Music,Brave,Books,\n"
	printf "  • Bitwarden: login and paste new token session in gopass\n"
	printf "  • YAY: Install downgrade,ventoy-bin,dragon-drop,brave-origin\n"
	printf "               grpcurl-bin, helium-browser-bin\n"
	printf "═══════════════════════════════════════════════\n"
}

# ── Entry point ───────────────────────────────────────────────────────────────

main() {
	secrets
	setup_deps
	run
	post
}

main "$@"
